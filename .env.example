# ── Required ────────────────────────────────────────────────────────────────────
# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY = 

# Hack Club OAuth 2.0 credentials (register at https://identity.hackclub.com)
HACKCLUB_CLIENT_ID = 
HACKCLUB_CLIENT_SECRET = 

# ── Optional ───────────────────────────────────────────────────────────────────
# Base URL for OAuth redirect URIs (falls back to request host if empty).
# Set this when testing locally behind a reverse proxy or on a non-standard port.
BASE_URL = 

# Vercel Blob token for project image uploads. Auto-injected when you create a
# Blob store in the Vercel dashboard. Alternative: set VERCEL_OIDC_TOKEN instead.
BLOB_READ_WRITE_TOKEN = 

# Hackatime OAuth 2.0 credentials (register at https://hackatime.hackclub.com/oauth/applications).
# Lets members connect Hackatime with one click instead of pasting a numeric user ID.
HACKATIME_CLIENT_ID = 
HACKATIME_CLIENT_SECRET = 

# Comma-separated allowlist of admin emails. Admins see/edit every club and
# review shipped projects. Example: admin@example.com, coadmin@example.com
ADMIN_EMAILS = 

# ── Storage Backend ────────────────────────────────────────────────────────────
# Set to "airtable" for multi-user shared state, or leave unset / "session" for
# cookie-based single-user storage (good for local dev and single-leader clubs).
STORAGE_BACKEND = session

# ── Airtable (required only when STORAGE_BACKEND=airtable) ────────────────────
# Personal access token from https://airtable.com/create/tokens
AIRTABLE_TOKEN = 
# Base ID from the Airtable API page (starts with "app...")
AIRTABLE_BASE_ID = 

# Override default Airtable table names (all optional, defaults shown):
# AIRTABLE_TABLE_CLUBS = Clubs
# AIRTABLE_TABLE_MEMBERS = Members
# AIRTABLE_TABLE_EVENTS = Events
# AIRTABLE_TABLE_NEWSLETTERS = Newsletters
# AIRTABLE_TABLE_ORDERS = Orders
# AIRTABLE_TABLE_ITEM_REQUESTS = ItemRequests
# AIRTABLE_TABLE_PROJECTS = Projects
